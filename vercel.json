{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sinapsiscentro.com.ar" }],
      "destination": "https://sinapsiscentro.com.ar/:path*",
      "permanent": true
    },
    { "source": "/recursos", "destination": "/#recursos", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(self), camera=()" }
      ]
    }
  ]
}
